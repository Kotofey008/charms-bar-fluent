<local:ShellWindow x:Class="CharmsBarPort.CharmsMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CharmsBarPort"
        mc:Ignorable="d"
        Title="Charms Menu"
        ResizeMode="NoResize"
        Topmost="True"
        Width="Auto"
        Height="240"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="/Icon.png">
    <Grid Name="CharmMenu" Margin="0,0,0,0" Height="220">

        <StackPanel Grid.Row="1" Background="Transparent" Margin="0,0,0,0" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
        </StackPanel>

        <StackPanel Name="SettingsBG" Grid.Row="1" Background="Transparent" Margin="0,8,0,0" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
            <Image Name="SettingsCharm" Source="/Assets/Images/Settings.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="24" Margin="15,0,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
        </StackPanel>

        <Label Name="SettingsText" Content="Settings" Foreground="#A0A0A0" FontFamily="Segoe UI Emoji" FontSize="15.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,5,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

        <StackPanel Name="DevicesBG" Grid.Row="2" Background="Transparent" Margin="0,48,0,0" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
            <Image Name="DevicesCharm" Source="/Assets/Images/Devices.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="24" Margin="15,0,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
        </StackPanel>

        <Label Name="DevicesText" Content="Devices" Foreground="#A0A0A0" FontFamily="Segoe UI Emoji" FontSize="15.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,45,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

        <StackPanel Name="ShareBG" Grid.Row="3" Background="Transparent" Margin="0,88,0,0" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
            <Image Name="ShareCharm" Source="/Assets/Images/Share.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="24" Margin="15,0,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
        </StackPanel>

        <Label Name="ShareText" Content="Share" Foreground="#A0A0A0" FontFamily="Segoe UI Emoji" FontSize="15.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,85,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

        <StackPanel Name="SearchBG" Grid.Row="4" Background="Transparent" Margin="0,128,0,0" VerticalAlignment="Top" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
            <Image Name="SearchCharm" Source="/Assets/Images/Search.png" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" Width="24" Margin="15,0,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
        </StackPanel>

        <Label Name="SearchText" Content="Search" Foreground="#A0A0A0" FontFamily="Segoe UI Emoji" FontSize="15.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="47,125,0,0" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>


        <StackPanel Name="WinBG" Grid.Row="5" Background="Transparent" Margin="0,0,0,0" VerticalAlignment="Bottom" UseLayoutRounding="True" SnapsToDevicePixels="True" Height="60">
            <StackPanel Name="MetroColor" Background="Transparent" Margin="5,0,0,0" HorizontalAlignment="Left" SnapsToDevicePixels="True" Height="30" Width="39">
                <!-- Accent-coloured Windows logo, clipped to the four panes (the old opaque plate image is gone). -->
                <Grid Name="WinAccentHost" HorizontalAlignment="Left" VerticalAlignment="Top" Width="45" Height="45" Margin="0,-3,0,0" IsHitTestVisible="False"
                      Clip="M 21.29,12.38 L 33.99,10.69 L 33.91,21.38 L 21.46,21.38 Z M 10.85,13.58 L 20.25,12.62 L 20.09,21.38 L 10.61,21.29 Z M 10.85,22.34 L 20.01,22.34 L 20.25,31.10 L 10.61,29.97 Z M 21.54,22.34 L 33.83,22.34 L 33.99,33.03 L 21.46,31.50 Z">
                    <Rectangle Name="WinAccent" Fill="{x:Static SystemParameters.WindowGlassBrush}"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Label Name="WinText" Content="Start       " Foreground="#A0A0A0" FontFamily="Segoe UI Emoji" FontSize="15.2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="47,165,12,-63" Visibility="Visible" UseLayoutRounding="True" SnapsToDevicePixels="True"/>

        <StackPanel Grid.Row="0" Width="Auto">
            <Label Name="useMenu" Content="-1" Foreground="{x:Static SystemColors.WindowTextBrush}" Visibility="Hidden"/>
        </StackPanel>
    </Grid>
</local:ShellWindow>
